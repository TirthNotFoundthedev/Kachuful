{
  "name": "@kachuful/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Authoritative Socket.IO game server for Kachuful",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "build:exe": "tsup --config tsup.exe.config.ts && node --build-sea sea-config.json"
  },
  "dependencies": {
    "socket.io": "4.8.4"
  },
  "devDependencies": {
    "@kachuful/shared": "workspace:*",
    "@types/node": "22.20.5",
    "socket.io-client": "4.8.4",
    "tsup": "8.5.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
