# Port to listen on. Render sets PORT automatically.
PORT=3001

# Comma-separated list of allowed browser origins for CORS / Socket.IO.
# Use "*" wildcards for preview deployments, e.g. https://kachuful-*.vercel.app
CLIENT_ORIGINS=http://localhost:5173,https://your-app.vercel.app

# Optional tuning (milliseconds)
# BOT_DELAY_MIN_MS=700
# BOT_DELAY_MAX_MS=1300
# TRICK_PAUSE_MS=1600
# ROUND_SUMMARY_MS=9000
# DISCONNECT_GRACE_MS=10000
# AWAY_DELAY_MS=1200
# ROOM_IDLE_TTL_MS=900000
# LOBBY_GHOST_MS=90000
